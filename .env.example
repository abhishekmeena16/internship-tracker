# ===================================================
# Internship Tracker — Environment Configuration
# ===================================================

# Database (PostgreSQL)
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship_tracker?schema=public"
# Hosted example (Supabase/Neon/Railway):
# DATABASE_URL="postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/internship_tracker?sslmode=require"

# API Service
API_PORT=4000
API_URL=http://localhost:4000

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication & Security
# Generate a strong 32+ character string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-very-strong-secret-key-in-production

# Email Service (SMTP for OTP Verification)
# Leave empty in local dev to see OTP codes printed directly in the server console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="Internship Tracker <noreply@internshiptracker.in>"

# Background Ingestion / Crawler Schedule
SYNC_INTERVAL_MINUTES=30
DISABLE_SCHEDULER=false

# Optional Monitoring
# SENTRY_DSN=
