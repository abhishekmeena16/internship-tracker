{
  "name": "internship-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A responsive website listing current internship openings at top 500 companies in India for CSE-related roles",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean:ports": "lsof -ti :4000 -ti :3000 -ti :3001 | xargs kill -9 2>/dev/null || true",
    "predev": "npm run clean:ports",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev": "concurrently -k -r \"npm run dev:api\" \"npm run dev:web\"",
    "start:web": "npm run start --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "start": "concurrently -k -r \"npm run start:api\" \"npm run start:web\"",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:push": "npm run push --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "ingest": "node packages/ingestion/scripts/sync-all-live.js",
    "ingest:live": "node packages/ingestion/scripts/sync-all-live.js",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
